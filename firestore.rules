rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow get, create, update: if request.auth != null
                                 && request.auth.uid == userId;
      allow list, delete: if false;

      match /fcm_tokens/{tokenId} {
        allow read, delete: if request.auth != null
                             && request.auth.uid == userId;

        allow create, update: if request.auth != null
                              && request.auth.uid == userId
                              && request.resource.data.keys().hasOnly([
                                'token', 'platform', 'updatedAt'
                              ])
                              && request.resource.data.token is string
                              && request.resource.data.platform == 'android';
      }
    }

    // Direktori profil untuk menampilkan semua pengguna kepada akun yang sudah login.
    match /user_directory/{userId} {
      allow get, list: if request.auth != null;

      allow create, update: if request.auth != null
                            && request.auth.uid == userId
                            && request.resource.data.keys().hasOnly([
                              'uid', 'displayName', 'updatedAt'
                            ])
                            && request.resource.data.uid == request.auth.uid
                            && request.resource.data.displayName is string
                            && request.resource.data.displayName.size() >= 2
                            && request.resource.data.displayName.size() <= 30;

      allow delete: if false;
    }

    match /user_lookup/{emailKey} {
      allow get: if false;
      allow list: if false;
      allow create, update: if request.auth != null
                            && request.resource.data.uid == request.auth.uid
                            && request.resource.data.email == request.auth.token.email;
      allow delete: if request.auth != null
                    && resource.data.uid == request.auth.uid;
    }

    match /brushapp_test/{userId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    function signedIn() {
      return request.auth != null;
    }

    function isMember(data) {
      return signedIn()
             && data.members is list
             && request.auth.uid in data.members;
    }

    function isConversationMember(conversationId) {
      return signedIn()
             && exists(/databases/$(database)/documents/conversations/$(conversationId))
             && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.members;
    }

    match /conversations/{conversationId} {
      // Authenticated users may check a deterministic conversation ID;
      // an existing conversation is readable only by its two members.
      allow get: if signedIn() && (resource == null || isMember(resource.data));
      allow list: if isMember(resource.data);

      allow create: if signedIn()
                    && request.resource.data.keys().hasOnly([
                      'members', 'memberInfo', 'createdBy',
                      'createdAt', 'updatedAt', 'lastMessage', 'lastSenderUid'
                    ])
                    && request.resource.data.members is list
                    && request.resource.data.members.size() == 2
                    && request.auth.uid in request.resource.data.members
                    && request.resource.data.members[0] != request.resource.data.members[1]
                    && request.resource.data.createdBy == request.auth.uid
                    && request.resource.data.memberInfo is map;

      allow update: if isMember(resource.data)
                    && request.resource.data.members == resource.data.members
                    && request.resource.data.memberInfo == resource.data.memberInfo
                    && request.resource.data.createdBy == resource.data.createdBy
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['lastMessage', 'lastSenderUid', 'updatedAt'])
                    && request.resource.data.lastSenderUid == request.auth.uid
                    && request.resource.data.lastMessage is string
                    && request.resource.data.lastMessage.size() <= 4000;

      allow delete: if false;

      match /messages/{messageId} {
        allow get, list: if isConversationMember(conversationId);

        allow create: if isConversationMember(conversationId)
                      && request.resource.data.keys().hasOnly(['senderUid', 'text', 'createdAt'])
                      && request.resource.data.senderUid == request.auth.uid
                      && request.resource.data.text is string
                      && request.resource.data.text.size() > 0
                      && request.resource.data.text.size() <= 4000
                      && request.resource.data.createdAt == request.time;

        allow update, delete: if false;
      }
    }
  }
}
