rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow get, create, update: if request.auth != null
                                 && request.auth.uid == userId;
      allow list, delete: if false;

      match /fcm_tokens/{tokenId} {
        allow read, delete: if request.auth != null
                             && request.auth.uid == userId;

        allow create, update: if request.auth != null
                              && request.auth.uid == userId
                              && request.resource.data.keys().hasOnly([
                                'token', 'platform', 'updatedAt'
                              ])
                              && request.resource.data.token is string
                              && request.resource.data.platform == 'android';
      }
    }

    // Direktori profil untuk menampilkan semua pengguna kepada akun yang sudah login.
    match /user_directory/{userId} {
      allow get, list: if request.auth != null;

      allow create, update: if request.auth != null
                            && request.auth.uid == userId
                            && request.resource.data.keys().hasOnly([
                              'uid', 'displayName', 'photoBase64', 'updatedAt'
                            ])
                            && request.resource.data.uid == request.auth.uid
                            && request.resource.data.displayName is string
                            && request.resource.data.displayName.size() >= 2
                            && request.resource.data.displayName.size() <= 30
                            && (!request.resource.data.keys().hasAny(['photoBase64'])
                                || (request.resource.data.photoBase64 is string
                                    && request.resource.data.photoBase64.size() <= 300000));

      allow delete: if false;
    }

    match /user_lookup/{emailKey} {
      allow get: if false;
      allow list: if false;
      allow create, update: if request.auth != null
                            && request.resource.data.uid == request.auth.uid
                            && request.resource.data.email == request.auth.token.email;
      allow delete: if request.auth != null
                    && resource.data.uid == request.auth.uid;
    }

    match /brushapp_test/{userId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    function signedIn() {
      return request.auth != null;
    }

    function isMember(data) {
      return signedIn()
             && data.members is list
             && request.auth.uid in data.members;
    }

    function friendshipPath(friendshipId) {
      return /databases/$(database)/documents/friendships/$(friendshipId);
    }

    function acceptedFriendship(friendshipId, firstUid, secondUid) {
      return signedIn()
             && exists(friendshipPath(friendshipId))
             && get(friendshipPath(friendshipId)).data.status == 'accepted'
             && get(friendshipPath(friendshipId)).data.users is list
             && firstUid in get(friendshipPath(friendshipId)).data.users
             && secondUid in get(friendshipPath(friendshipId)).data.users;
    }

    function conversationAllowed(data, conversationId) {
      return isMember(data)
             && data.members.size() == 2
             && (!data.keys().hasAny(['friendshipId'])
                 || data.friendshipId == conversationId)
             && acceptedFriendship(conversationId, data.members[0], data.members[1]);
    }

    function isConversationMember(conversationId) {
      return signedIn()
             && exists(/databases/$(database)/documents/conversations/$(conversationId))
             && conversationAllowed(get(/databases/$(database)/documents/conversations/$(conversationId)).data, conversationId);
    }

    match /friendships/{friendshipId} {
      allow get: if signedIn()
                  && (resource == null
                      || (resource.data.users is list && request.auth.uid in resource.data.users));
      allow list: if signedIn()
                  && (resource.data.requesterUid == request.auth.uid
                      || resource.data.recipientUid == request.auth.uid);

      allow create: if signedIn()
                    && request.resource.data.keys().hasOnly([
                      'users', 'requesterUid', 'recipientUid',
                      'requesterName', 'status', 'requestedAt'
                    ])
                    && request.resource.data.users is list
                    && request.resource.data.users.size() == 2
                    && request.auth.uid in request.resource.data.users
                    && request.resource.data.requesterUid == request.auth.uid
                    && request.resource.data.recipientUid in request.resource.data.users
                    && request.resource.data.recipientUid != request.auth.uid
                    && request.resource.data.status == 'pending'
                    && request.resource.data.requesterName is string
                    && request.resource.data.requestedAt == request.time;

      allow update: if signedIn()
                    && resource.data.users is list
                    && request.auth.uid in resource.data.users
                    && request.resource.data.users == resource.data.users
                    && request.resource.data.requesterName == resource.data.requesterName
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['status', 'respondedAt', 'requestedAt', 'requesterUid', 'recipientUid'])
                    && (
                      (resource.data.status == 'pending'
                       && request.auth.uid == resource.data.recipientUid
                       && request.resource.data.status in ['accepted', 'rejected']
                       && request.resource.data.requesterUid == resource.data.requesterUid
                       && request.resource.data.recipientUid == resource.data.recipientUid
                       && request.resource.data.respondedAt is timestamp)
                      ||
                      (resource.data.status == 'rejected'
                       && request.auth.uid == resource.data.requesterUid
                       && request.resource.data.status == 'pending'
                       && request.resource.data.requesterUid == request.auth.uid
                       && request.resource.data.recipientUid == resource.data.recipientUid
                       && request.resource.data.requestedAt == request.time
                       && !request.resource.data.keys().hasAny(['respondedAt']))
                    );

      allow delete: if false;
    }

    match /conversations/{conversationId} {
      allow get: if signedIn() && (resource == null || conversationAllowed(resource.data, conversationId));
      allow list: if conversationAllowed(resource.data, conversationId);

      allow create: if signedIn()
                    && request.resource.data.keys().hasOnly([
                      'members', 'friendshipId', 'memberInfo', 'createdBy',
                      'createdAt', 'updatedAt', 'lastMessage', 'lastSenderUid'
                    ])
                    && request.resource.data.members is list
                    && request.resource.data.members.size() == 2
                    && request.auth.uid in request.resource.data.members
                    && request.resource.data.members[0] != request.resource.data.members[1]
                    && request.resource.data.createdBy == request.auth.uid
                    && request.resource.data.memberInfo is map
                    && request.resource.data.friendshipId == conversationId
                    && acceptedFriendship(conversationId, request.resource.data.members[0], request.resource.data.members[1]);

      // Izinkan migrasi satu kali untuk ruang chat lama yang belum memiliki friendshipId.
      // Migrasi hanya boleh menambahkan friendshipId yang cocok; tidak boleh mengubah isi chat.
      // Setelah itu, update pesan mengikuti aturan normal di bawah.
      allow update: if conversationAllowed(resource.data, conversationId)
                    && request.resource.data.members == resource.data.members
                    && request.resource.data.memberInfo == resource.data.memberInfo
                    && request.resource.data.createdBy == resource.data.createdBy
                    && (
                      (
                        !resource.data.keys().hasAny(['friendshipId'])
                        && request.resource.data.friendshipId == conversationId
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['friendshipId'])
                      )
                      ||
                      (
                        resource.data.friendshipId == conversationId
                        && request.resource.data.friendshipId == conversationId
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['lastMessage', 'lastSenderUid', 'updatedAt'])
                        && request.resource.data.lastSenderUid == request.auth.uid
                        && request.resource.data.lastMessage is string
                        && request.resource.data.lastMessage.size() <= 4000
                      )
                    );

      allow delete: if false;

      match /messages/{messageId} {
        allow get, list: if isConversationMember(conversationId);

        allow create: if isConversationMember(conversationId)
                      && request.resource.data.keys().hasOnly(['senderUid', 'text', 'createdAt'])
                      && request.resource.data.senderUid == request.auth.uid
                      && request.resource.data.text is string
                      && request.resource.data.text.size() > 0
                      && request.resource.data.text.size() <= 4000
                      && request.resource.data.createdAt == request.time;

        allow update: if isConversationMember(conversationId)
                      && resource.data.senderUid != request.auth.uid
                      && !resource.data.keys().hasAny(['readAt'])
                      && request.resource.data.keys().hasOnly(['senderUid', 'text', 'createdAt', 'readAt'])
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt'])
                      && request.resource.data.readAt == request.time;

        allow delete: if false;
      }
    }
  }
}
